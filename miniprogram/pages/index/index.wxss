.masthead { margin:4rpx 0 8rpx; }
.wordmark { font-size:47rpx; font-weight:800; letter-spacing:-2rpx; }
.brand-dashes { margin-left:5rpx; color:#7c925d; }
.city-description { margin-left:auto; color:#5f6659; font-size:22rpx; }
.hero { position:relative; height:310rpx; overflow:hidden; border-radius:20rpx; background:#f3f3ed; margin-top:8rpx; }
.hero-art { position:absolute; width:100%; height:100%; top:0; left:0; }
.hero-copy { position:relative; z-index:1; padding:30rpx; }
.hero-copy .eyebrow { font-size:20rpx; letter-spacing:1rpx; }
.hero-title { font-size:50rpx; font-weight:750; line-height:1.22; letter-spacing:-1rpx; margin-top:18rpx; }
.hero-sub { font-size:24rpx; color:#505947; margin-top:18rpx; max-width:275rpx; }
