.picker-field { padding:18rpx; border:1rpx solid #dfe5d7; border-radius:12rpx; }.type-grid { display:flex; flex-wrap:wrap; gap:14rpx; }.type { width:calc(50% - 7rpx); padding:20rpx 0; background:#f1f3ec; color:#616a56; }.type.active { background:#20231f; color:#fff; }.notes { width:100%; min-height:240rpx; background:#f7f8f3; border:1rpx solid #e0e5d7; border-radius:12rpx; padding:20rpx; font-size:26rpx; line-height:1.7; }
